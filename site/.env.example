# ── commercetools (server-only — NEVER prefix with NEXT_PUBLIC) ────────────────
# New EU-region project for the Cave Bellevin demo. Get these from
# Merchant Center → Settings → Developer settings → Create new API client
# (scope: manage_project — dev project, broad is fine).
CTP_PROJECT_KEY=cave-bellevin-demo
CTP_CLIENT_ID=
CTP_CLIENT_SECRET=
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_SCOPES=manage_project:cave-bellevin-demo

# If you chose eu-central-1.aws instead of europe-west1.gcp:
#   CTP_AUTH_URL=https://auth.eu-central-1.aws.commercetools.com
#   CTP_API_URL=https://api.eu-central-1.aws.commercetools.com

# ── storefront session signing key (server-only) ──────────────────────────────
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# ── Zscaler TLS interception (machine-specific, only if you are behind Zscaler) ─
# Node rejects the intercepted product-image CDN without its CA. Export the cert and point here:
#   security find-certificate -a -c "Zscaler" -p /Library/Keychains/System.keychain > ~/zscaler-root.pem
# NODE_EXTRA_CA_CERTS=/Users/you/zscaler-root.pem
